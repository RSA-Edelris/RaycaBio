; Energy minimisation
integrator      = steep
nsteps          = 10000
emtol           = 100.0
emstep          = 0.01
nstlist         = 10
cutoff-scheme   = Verlet
ns_type         = grid
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz
DispCorr        = EnerPres
